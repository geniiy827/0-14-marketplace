{
  "format_version": "1.8.0",
  "animations": {
    "animation.humanoid.legs": {
      "loop": true,
      "anim_time_update": "query.modified_distance_moved",
      "bones": {
        "rightLeg": {
          "rotation": [
            "math.cos(query.anim_time * 38.17) * 80.0 * query.modified_move_speed",
            0.0,
            0.0
          ]
        },
        "leftLeg": {
          "rotation": [
            "math.cos(query.anim_time * 38.17 + 180.0) * 80.0 * query.modified_move_speed",
            0.0,
            0.0
          ]
        }
      }
    },
    "animation.common.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0.0
          ]
        }
      }
    }
  }
}
