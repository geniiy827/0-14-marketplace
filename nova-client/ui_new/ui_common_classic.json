{
  "namespace": "common-classic",

  //---------------------------------------------------------------------------
  // NOVA theme: classic buttons -> rounded, tinted, outlined buttons.
  // NormalButtonStroke.png is neutral grey/white, so "color" tints it fully.
  //---------------------------------------------------------------------------

  "button": {
    "type": "button",
    "layer": 1,
    "size": [ 100, 20 ],
    "sound_name": "random.click",
    "sound_volume": 1.0,
    "sound_pitch": 1.25,
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "focus_enabled": true,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_select",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.menu_select",
        "mapping_type": "focused"
      }
    ]
  },

  "button_state_default": {
    "type": "image",
    "texture": "gui/newgui/NormalButtonStroke.png",
    "nineslice_size": 4.0,
    "uv": [ 0, 0 ],
    "uv_size": [ 12, 12 ],
    "color": [ 0.47, 0.53, 0.68, 1.0 ],
    "alpha": 0.92
  },

  "button_state_hover@button_state_default": {
    "color": [ 0.34, 0.8, 0.82, 1.0 ],
    "alpha": 1.0
  },

  "button_state_pressed@button_state_default": {
    "color": [ 0.24, 0.62, 0.66, 1.0 ],
    "alpha": 1.0
  },

  "toggle@common.toggle": {
    "$unchecked_control": "common-classic.toggle_unchecked_state",
    "$checked_control": "common-classic.toggle_checked_state",
    "$unchecked_hover_control": "common-classic.toggle_unchecked_hovered_state",
    "$checked_hover_control": "common-classic.toggle_checked_hovered_state",
    "$unchecked_locked_control": "common-classic.toggle_unchecked_hovered_state",
    "$checked_locked_control": "common-classic.toggle_checked_hovered_state"
  },

  "toggle_checked_state": {
    "type": "image",
    "texture": "gui/touchgui.png",
    "layer": 2,
    "nineslice_size": 3.0,
    "uv": [ 199, 206 ],
    "uv_size": [ 38, 20 ],
    "size": [ 38, 20 ],
    "color": [ 0.55, 1.0, 0.92, 1.0 ]
  },

  "toggle_unchecked_state": {
    "type": "image",
    "texture": "gui/touchgui.png",
    "layer": 2,
    "nineslice_size": 3.0,
    "uv": [ 160, 206 ],
    "uv_size": [ 38, 20 ],
    "size": [ 38, 20 ],
    "color": [ 0.62, 0.66, 0.8, 1.0 ]
  },

  "toggle_checked_hovered_state": {
    "type": "panel",
    "size": [ 38, 20 ],
    "controls": [
      { "@toggle_checked_state": { } },
      {
        "hover": {
          "type": "image",
          "texture": "gui/touchgui.png",
          "layer": 3,
          "nineslice_size": 3.0,
          "uv": [ 160, 226 ],
          "uv_size": [ 38, 20 ],
          "color": [ 0.4, 0.95, 0.88, 1.0 ]
        }
      }
    ]
  },

  "toggle_unchecked_hovered_state": {
    "type": "panel",
    "size": [ 38, 20 ],
    "controls": [
      { "@toggle_unchecked_state": { } },
      {
        "hover": {
          "type": "image",
          "texture": "gui/touchgui.png",
          "layer": 3,
          "nineslice_size": 3.0,
          "uv": [ 199, 226 ],
          "uv_size": [ 38, 20 ],
          "color": [ 0.4, 0.95, 0.88, 1.0 ]
        }
      }
    ]
  }
}
