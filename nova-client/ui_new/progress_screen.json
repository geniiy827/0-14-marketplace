{
  "namespace": "progress",

  "progress_screen_text": {
    "type": "label",
    "anchor_to": "center",
    "anchor_from": "center",
    "layer": 2,
    "alignment": "center",
    "shadow": true
  },

  "progress_title_text@progress.progress_screen_text": {
    "offset": [ 0, -15 ],
    "color": [ 0.9, 0.95, 1.0, 1.0 ],
    "alpha": "@common.anim_fade_in",
    "text": "#title_text",
    "bindings": [
      {
        "binding_name": "#title_text",
        "binding_condition": "visible"
      }
    ]
  },

  "progress_bar_text@progress.progress_screen_text": {
    "offset": [ 0, 9 ],
    "color": [ 0.62, 0.67, 0.78, 1.0 ],
    "text": "#progress_text",
    "bindings": [
      { "binding_name": "#progress_text" }
    ]
  },

  "bar_animation": {
    "anim_type": "flip_book",
    "initial_uv": [ 0, 0 ],
    "frame_count": 10,
    "frame_step": 64,
    "fps": 10,
    "reversible": true,
    "easing": "linear",
    "next": "@bar_forward"
  },

  "progress_loading_bars": {
    "type": "image",
    "layer": 2,
    "texture": "gui/newgui/loading_bar.png",
    "anchor_from": "center",
    "anchor_to": "center",
    "offset": [ 0, 24 ],
    "size": [ 64, 8 ],
    "uv_size": [ 64, 8 ],
    "uv": "@bar_animation",
    "color": "@common.anim_accent_breath_a",
    "bindings": [
      {
        "binding_name": "#bar_animation_visible",
        "binding_name_override": "#visible"
      }
    ]
  },

  "progress_bar": {
    "type": "custom",
    "renderer": "progress_bar_renderer",
    "layer": 2,
    "offset": [ 0, 16 ],
    "size": [ 140, 3 ],
    "primary_color": [ 0.4, 0.95, 0.88, 1.0 ],
    "secondary_color": [ 0.16, 0.18, 0.28, 1.0 ],
    "bindings": [
      {
        "binding_name_override": "#progress_bar_visible",
        "binding_name": "#loading_bar_visible"
      },
      {
        "binding_name_override": "#progress_bar_total_amount",
        "binding_name": "#loading_bar_total_amount",
        "binding_condition": "visible"
      },
      {
        "binding_name_override": "#progress_bar_current_amount",
        "binding_name": "#loading_bar_current_amount",
        "binding_condition": "visible"
      }
    ]
  },

  "cancel_button_text@progress.progress_screen_text": {
    "type": "label",
    "layer": 4,
    "alignment": "center",
    "text": "gui.cancel",
    "shadow": true
  },

  "cancel_button@common.button": {
    "$pressed_button_name": "button.menu_exit",
    "size": [ 80, 22 ],
    "offset": [ 0, 55 ],
    "bindings": [
      {
        "binding_name": "#cancel_visible",
        "binding_name_override": "#visible"
      }
    ],
    "controls": [
      {
        "default@$button_state_default_base": {
          "controls": [
            {
              "@progress.cancel_button_text": {
                "color": [ 1.0, 1.0, 1.0, 1.0 ]
              }
            }
          ]
        }
      },
      {
        "hover@$button_state_hover_base": {
          "controls": [
            {
              "@progress.cancel_button_text": {
                "color": [ 0.4, 0.95, 0.88, 1.0 ]
              }
            }
          ]
        }
      },
      {
        "pressed@$button_state_pressed_base": {
          "controls": [
            {
              "@progress.cancel_button_text": {
                "color": [ 0.4, 0.95, 0.88, 1.0 ],
                "alpha": 0.65
              }
            }
          ]
        }
      }
    ]
  },

  "anim_brand_drop": {
    "anim_type": "offset",
    "easing": "out_back",
    "duration": 0.5,
    "from": [ 0, -60 ],
    "to": [ 0, -42 ]
  },

  "brand_label": {
    "type": "label",
    "localize": false,
    "text": "N O V A",
    "anchor_from": "center",
    "anchor_to": "center",
    "alignment": "center",
    "layer": 3,
    "shadow": true,
    "color": [ 0.4, 0.95, 0.88 ],
    "offset": "@progress.anim_brand_drop"
  },

  "title_panel": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "@progress.brand_label": { }
      },
      {
        "title_line@common.accent_line": {
          "size": [ 90, 1 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, -30 ],
          "layer": 3,
          "alpha": 0.7
        }
      },
      {
        "@progress.progress_title_text": {
        }
      },
      {
        "@progress.progress_bar_text": { }
      },
      {
        "@progress.progress_bar": { }
      }
    ]
  },

  "button_panel": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "@progress.cancel_button": { }
      }
    ]
  },

  "gamepad_helpers": {
    "type": "panel",
    "size": [ 100, 10 ],
    "offset": [ 0, "45%" ],
    "controls": [
      {
        "@common.gamepad_helper_a": {
          "size": [ "50%", "100%" ],
          "offset": [ 0, "2%" ],
          "anchor_from": "center",
          "anchor_to": "center"
        }
      }
    ]
  },

  //---------------------------------------------------------------------------
  // Screens
  //---------------------------------------------------------------------------

  "progress_screen@common.base_screen": {
    "variables": [
      {
        "requires": "$desktop_screen",
        "$button_state_default_base": "common.button_state_default",
        "$button_state_hover_base": "common.button_state_hover",
        "$button_state_pressed_base": "common.button_state_pressed",
        "$render_dirt_bg": true
      },
      {
        "requires": "$pocket_screen",
        "$button_state_default_base": "common-classic.button_state_default",
        "$button_state_hover_base": "common-classic.button_state_hover",
        "$button_state_pressed_base": "common-classic.button_state_pressed",
        "$render_dirt_bg": true
      }
    ],
    "controls": [
      {
        "@common.dirt_background": {
          "visible": "$render_dirt_bg"
        }
      },
      {
        "@progress.progress_loading_bars": { }
      },
      {
        "@progress.title_panel": { }
      },
      {
        "@progress.gamepad_helpers": { }
      },
      {
        "@progress.button_panel": { }
      }
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ]
  }
}
