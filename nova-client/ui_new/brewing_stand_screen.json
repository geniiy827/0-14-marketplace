{
  "namespace": "brewing_stand",
  //-----------------------------------------------------------
  // Images
  //-----------------------------------------------------------

  "brewing_pipes": {
    "type": "image",
    "layer": 2,
    "texture": "gui/spritesheet2.png",
    "offset": [ -1, 0 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [ 27, 18 ],
    "uv": [ 59, 1 ],
    "uv_size": [ 30, 20 ],
    "color": [ 0.62, 0.7, 0.95, 1.0 ]
  },

  "bottle_empty_image": {
    "type": "image",
    "texture": "gui/spritesheet2.png",
    "layer": 2,
    "offset": [ 1, -1 ],
    "size": [ 14, 14 ],
    "uv": [ 42, 0 ],
    "uv_size": [ 16, 16 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "#empty_bottle_image_visible",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      }
    ]
  },

  "bubbles_empty_image": {
    "type": "image",
    "texture": "gui/spritesheet2.png",
    "layer": 2,
    "offset": [ -15, -13 ],
    "size": [ 11, 26 ],
    "uv": [ 0, 0 ],
    "uv_size": [ 12, 29 ],
    "anchor_from": "center",
    "anchor_to": "center"
  },

  "bubbles_full_image": {
    "type": "image",
    "texture": "gui/spritesheet2.png",
    "layer": 3,
    "offset": [ -15, -13 ],
    "size": [ 11, 26 ],
    "uv": [ 12, 0 ],
    "uv_size": [ 12, 29 ],
    "nineslice_size": 0.0,
    "clip_direction": "down",
    "bindings": [
      {
        "binding_name": "#brewing_bubbles_ratio",
        "binding_name_override": "#clip_ratio",
        "binding_condition": "visible"
      }
    ]
  },

  "brewing_arrow_empty_image": {
    "type": "image",
    "layer": 1,
    "texture": "gui/spritesheet2.png",
    "offset": [ 12, -12 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [ 8, 25 ],
    "uv": [ 24, 0 ],
    "uv_size": [ 9, 28 ],
    "color": [ 0.45, 0.52, 0.7, 1.0 ]
  },

  "brewing_arrow_full_image": {
    "type": "image",
    "layer": 3,
    "texture": "gui/spritesheet2.png",
    "anchor_from": "center",
    "anchor_to": "center",
    "offset": [ 12, -12 ],
    "size": [ 8, 25 ],
    "uv": [ 33, 0 ],
    "uv_size": [ 9, 28 ],
    "color": [ 0.4, 0.95, 0.88, 1.0 ],
    "nineslice_size": 0.0,
    "clip_direction": "up",
    "bindings": [
      {
        "binding_name": "#brewing_arrow_ratio",
        "binding_name_override": "#clip_ratio",
        "binding_condition": "visible"
      }
    ]
  },

  //-----------------------------------------------------------
  // Screen
  //-----------------------------------------------------------

  "brewing_label": {
    "type": "label",
    "size": [ 36, 6 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "alignment": "center",
    "text": "item.brewingStand.name",
    "shadow": true,
    "color": [ 0.4, 0.95, 0.88, 1.0 ],
    "layer": 2
  },

  "brewingstand_output_grid_item@common.container_grid_item": {
    "size": [ 16, 16 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "$cell_overlay_ref": "brewing_stand.bottle_empty_image",
    "$item_collection_name": "brewing_result_items"
  },

  "output_grid": {
    "type": "grid",
    "offset": [ -18, 0 ],
    "layer": -1,
    "collection_name": "brewing_result_items",
    "controls": [
      {
        "output_grid_item1@brewing_stand.brewingstand_output_grid_item": {
          "grid_position": [ 0, 0 ],
          "offset": [ 19, 27 ]
        }
      },
      {
        "output_grid_item2@brewing_stand.brewingstand_output_grid_item": {
          "grid_position": [ 1, 0 ],
          "offset": [ 21, 33 ]
        }
      },
      {
        "output_grid_item3@brewing_stand.brewingstand_output_grid_item": {
          "grid_position": [ 2, 0 ],
          "offset": [ 24, 27 ]
        }
      }
    ]
  },

  "brewing_input_grid": {
    "type": "grid",
    "size": [ 18, "80%" ],
    "anchor_from": "center",
    "anchor_to": "center",
    "offset": [ 17, -17 ],
    "grid_dimensions": [ 5, 1 ],
    "controls": [
      { "@output_grid": { } },
      {
        "input_grid_item@common.container_grid_item": {
          "offset": [ 28, 1 ],
          "size": [ 16, 16 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "grid_position": [ 0, 0 ],
          "$item_collection_name": "brewing_input_item"
        }
      }
    ]
  },

  "brewing_input_panel": {
    "type": "panel",
    "size": [ "50%", "100%" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "@brewing_input_grid": { } }
    ]
  },

  "brewing_panel_top_half": {
    "type": "panel",
    "size": [ "100%", "50% - 11px" ],
    "offset": [ 0, 6 ],
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "controls": [
      { "@brewing_label": { } },
      { "input@brewing_input_panel": { } },
      { "@brewing_arrow_empty_image": { } },
      { "@brewing_arrow_full_image": { } },
      { "@bubbles_empty_image": { } },
      { "@bubbles_full_image": { } },
      { "@brewing_pipes": { } }
    ]
  },

  "brewing_stand_screen@common.inventory_screen_common": {
    "controls": [
      { "@common.container_gamepad_helpers": { } },
      { "@common.screen_background": { } },
      {
        "@common.root_panel": {
          "layer": 1,
          "controls": [
            { "@common.input_panel": { } },
            { "@common.common_panel": { } },
            {
              "furnace_screen_inventory": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  { "@brewing_stand.brewing_panel_top_half": { } },
                  { "@common.inventory_panel_bottom_half_with_label": { } },
                  { "hotbar_grid@common.hotbar_grid_template": { } },
                  { "@common.inventory_take_progress_icon_button": { } }
                ]
              }
            },
            { "@common.inventory_selected_icon_button": { } }
          ]
        }
      }
    ]
  }
}
