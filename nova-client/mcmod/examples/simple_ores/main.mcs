// ================================================================ крафты (recipe.*: NOVA возвращает их, когда игра заново заполняет книгу рецептов)
var STICK = 280
var STRING = 287

// материал: [руда, блок, кирпичи, слиток, самородок, инструменты (кирка, топор, лопата, меч, мотыга), броня (шлем, нагрудник, поножи, ботинки)]
fn sets() {
    return [
        [copper_ore, copper_block, copper_bricks, copper_ingot, copper_nugget, [copper_pickaxe, copper_axe, copper_shovel, copper_sword, copper_hoe], [copper_helmet, copper_chestplate, copper_leggings, copper_boots]],
        [tin_ore, tin_block, tin_bricks, tin_ingot, tin_nugget, [tin_pickaxe, tin_axe, tin_shovel, tin_sword, tin_hoe], [tin_helmet, tin_chestplate, tin_leggings, tin_boots]],
        [mythril_ore, mythril_block, mythril_bricks, mythril_ingot, mythril_nugget, [mythril_pickaxe, mythril_axe, mythril_shovel, mythril_sword, mythril_hoe], [mythril_helmet, mythril_chestplate, mythril_leggings, mythril_boots]],
        [adamantium_ore, adamantium_block, adamantium_bricks, adamantium_ingot, adamantium_nugget, [adamantium_pickaxe, adamantium_axe, adamantium_shovel, adamantium_sword, adamantium_hoe], [adamantium_helmet, adamantium_chestplate, adamantium_leggings, adamantium_boots]],
        [onyx_ore, onyx_block, onyx_bricks, onyx_gem, null, [onyx_pickaxe, onyx_axe, onyx_shovel, onyx_sword, onyx_hoe], [onyx_helmet, onyx_chestplate, onyx_leggings, onyx_boots]]
    ]
}

fn recipes() {
    for s in sets() {
        var I = s[3]
        recipe.smelt(s[0], I)
        recipe.shaped(s[1], ["III", "III", "III"], {I: I})
        recipe.shaped(I, ["B"], {B: s[1]}, 9)
        recipe.shaped(s[2], ["BB", "BB"], {B: s[1]}, 4)
        if s[4] != null {
            recipe.shaped(I, ["NNN", "NNN", "NNN"], {N: s[4]})
            recipe.shaped(s[4], ["I"], {I: I}, 9)
        }
        var t = s[5]
        recipe.shaped(t[0], ["III", " S ", " S "], {I: I, S: STICK})
        recipe.shaped(t[1], ["II", "IS", " S"], {I: I, S: STICK})
        recipe.shaped(t[2], ["I", "S", "S"], {I: I, S: STICK})
        recipe.shaped(t[3], ["I", "I", "S"], {I: I, S: STICK})
        recipe.shaped(t[4], ["II", " S", " S"], {I: I, S: STICK})
        var a = s[5 + 1]
        recipe.shaped(a[0], ["III", "I I"], {I: I})
        recipe.shaped(a[1], ["I I", "III", "III"], {I: I})
        recipe.shaped(a[2], ["III", "I I", "I I"], {I: I})
        recipe.shaped(a[3], ["I I", "I I"], {I: I})
    }
    // необработанная руда, пыль и дроблёная руда -> слиток; блоки необработанной руды
    for r in [[raw_tin, tin_ingot, raw_tin_block], [raw_mythril, mythril_ingot, raw_mythril_block], [raw_adamantium, adamantium_ingot, raw_adamantium_block]] {
        recipe.smelt(r[0], r[1])
        recipe.shaped(r[2], ["RRR", "RRR", "RRR"], {R: r[0]})
        recipe.shaped(r[0], ["B"], {B: r[2]}, 9)
    }
    for d in [[copper_dust, copper_ingot], [tin_dust, tin_ingot], [mythril_dust, mythril_ingot], [adamantium_dust, adamantium_ingot],
              [crushed_copper_ore, copper_ingot], [crushed_tin_ore, tin_ingot], [crushed_mythril_ore, mythril_ingot], [crushed_adamantium_ore, adamantium_ingot]] {
        recipe.smelt(d[0], d[1])
    }
    for o in [[deepslate_tin_ore, tin_ingot], [deepslate_mythril_ore, mythril_ingot], [deepslate_adamantium_ore, adamantium_ingot],
              [basalt_onyx_ore, onyx_gem], [blackstone_onyx_ore, onyx_gem]] {
        recipe.smelt(o[0], o[1])
    }
    recipe.shaped(mythril_rod, ["I", "I"], {I: mythril_ingot}, 4)
    recipe.shaped(onyx_rod, ["I", "I"], {I: onyx_gem}, 4)
}

fn give(code, count) {                 // номер предмета + 65536 * данные (предметы по данным)
    var it = mem.alloc(64)
    mc.call("ItemInstance::ItemInstance(int, int, int)", it, code % 65536, count, math.floor(code / 65536))
    mc.call("Inventory::add(ItemInstance&, bool)", mem.ptr(mc.player(), 0xda0), it, true)
}

on world.join(e) { recipes() }              // NOVA держит их в книге рецептов (повтор - не дубль)

on chat(e) {
    if e.text == "/simpleores" {
        e.cancel()
        ui.tip("§6Simple Ores§f: медь, олово, мифрил, адамантин, оникс (в Аду). Вкладка - стрелки вверху творческого инвентаря")
    } else if e.text == "/so give" {
        e.cancel()
        for s in sets() {
            give(s[3], 16)
            give(s[0], 8)
        }
        ui.tip("§6Simple Ores: §fслитки и руды выданы")
    }
}
