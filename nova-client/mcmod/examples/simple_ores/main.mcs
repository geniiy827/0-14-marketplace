// инструменты и броня с настоящими уровнями игры (Item::Tier, ArmorMaterial). Числа - из SimpleOresConfig.
// Своя вкладка в творческом инвентаре (стрелки сверху). Команды: /simpleores - что есть в моде, /so give - набор.

// ================================================================ блоки
block copper_ore {
    name: {ru: "Медная руда", en: "Copper Ore"}
    texture: "textures/block/copper_ore.png"
    hardness: 3
    resistance: 3
    harvest: 1                  // уровень кирки: 1 каменная, 2 железная, 3 алмазная
