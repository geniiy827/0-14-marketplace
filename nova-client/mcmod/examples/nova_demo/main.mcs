// NOVA Demo - пример мода на McMod Script
// Команды в чате: /heal /day /night /rain /clear /top /fly /give <предмет> [кол-во] /zombie

var broken = data.load("broken", 0)      // сколько блоков сломано за всё время

on world.join(e) {
    ui.tip("§bNOVA Demo§r загружен! Напиши /help")
}

on chat(e) {
    if not e.text.starts("/") { return }
    e.cancel()                            // команду не отправляем в чат
    var args = e.text.sub(1).split(" ")
    var cmd = args[0]

    if cmd == "help" {
        chat("§e/heal /day /night /rain /clear /top /fly /give <предмет> [кол-во] /zombie")
    } else if cmd == "heal" {
        player.setHealth(player.maxHealth())
        chat("§aЗдоровье восстановлено")
    } else if cmd == "day" {
        world.setTime(1000)
    } else if cmd == "night" {
        world.setTime(14000)
    } else if cmd == "rain" {
        world.setRain(1)
    } else if cmd == "clear" {
        world.setRain(0)
    } else if cmd == "top" {
        var x = math.floor(player.x())
        var z = math.floor(player.z())
        var y = 127
        while y > 0 and world.block(x, y, z) == 0 { y -= 1 }
        player.teleport(x + 0.5, y + 1, z + 0.5)
        chat("§aТы наверху (y = {y + 1})")
    } else if cmd == "give" {
        if len(args) < 2 { chat("§cНапиши: /give diamond 5"); return }
        var count = len(args) > 2 ? num(args[2]) : 1
        player.give(args[1], count)
        chat("§aВыдано: {args[1]} x{count}")
    } else if cmd == "fly" {
        player.setCanFly(not player.canFly())
        chat("§aПолёт: {player.canFly() ? "можно" : "нельзя"}")
    } else if cmd == "zombie" {
        var d = player.look()
        var z = world.spawn("zombie", player.x() + d.x * 3, player.y(), player.z() + d.z * 3)
        if z != null {
            entity.setNameTag(z, "§cДемо-зомби")
            entity.setArmor(z, 0, "golden_helmet")
        }
    } else {
        chat("§cНет такой команды. /help")
    }
}

// золотая кирка взрывает блок, который ломаешь
on block.break(e) {
    broken += 1
    if broken % 100 == 0 {
        ui.tip("Сломано блоков: {broken}")
        data.save("broken", broken)
    }
    if e.item == item.id("golden_pickaxe") {
        world.explode(e.x + 0.5, e.y + 0.5, e.z + 0.5, 2)
    }
}

// сообщение, когда умирает моб, которого ударил игрок
on entity.death(e) {
    if e.attacker == player.id() {
        ui.tip("Побеждён: {entity.typeName(e.id)}")
    }
}

on world.leave(e) {
    data.save("broken", broken)
}
