// NOVA Size - тестовый мод: размер игрока и мобов
//   /size 0.1        - стать в 10 раз меньше (1 = обычный, 0.05..16)
//   /px 2            - рост ровно 2 пикселя
//   /size            - вернуть обычный размер
//   /mobs 0.5        - все мобы в радиусе 16 блоков в 2 раза меньше
//   /mobs 3          - ... или в 3 раза больше

on chat(e) {
    var parts = e.text.trim().split(" ")
    var cmd = parts[0]
    var arg = len(parts) > 1 ? parts[1].num() : null

    if cmd == "/size" {
        e.cancel()
        var s = arg == null ? 1 : arg
        player.setScale(s)
        ui.tip("Размер: {player.scale()}")
    } else if cmd == "/px" {
        e.cancel()
        var px = arg == null ? 2 : arg
        player.setScale(px / 16 / 1.8)            // рост игрока - 1.8 блока
        ui.tip("Рост: {px} пикс.")
    } else if cmd == "/mobs" {
        e.cancel()
        var s = arg == null ? 1 : arg
        var n = 0
        for id in entity.list(16) {
            entity.setScale(id, s)
            n += 1
        }
        ui.tip("Мобов изменено: {n}")
    }
}

on world.join(e) {
    chat.send("§b[NOVA Size]§r /size 0.1, /px 2, /size - сброс, /mobs 0.5")
}
