// Adventure Craft. Постройки ставит генератор мира NOVA (structures.bin) в новых чанках, лут - в сундуках.
// Авторы оригинальных построек - CREDITS.txt.
on chat(e) {
    if e.text != "/adventure" { return }
    e.cancel()
    ui.tip("§6Adventure Craft§f: данжи (9 видов), пирамиды (8), башни (5), храм тайги, колодцы, обелиски, хижины ведьм, болотные арки и руины. Ищи в новых чанках.")
}
