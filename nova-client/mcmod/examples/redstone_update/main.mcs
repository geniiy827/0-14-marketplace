// Обновление редстоуна: тестовый мод для игры с друзьями.
// Блоки работают через схемы самой игры (CircuitSystem), как блок редстоуна и лампа: в общем мире всё считает
// хост, а у друзей тот же мод (меню «Друзья» само предложит его загрузить), поэтому картинка одинаковая.
// Выдать всё: команда /redstone в чате. Крафты добавляются при входе в мир.

item redstone_crystal {
    name: {ru: "Редстоун-кристалл", en: "Redstone crystal"}
    texture: "textures/redstone_crystal.png"
}

// источник сигнала силы 15, светится
block crystal_block {
    name: {ru: "Блок редстоун-кристаллов", en: "Redstone crystal block"}
    texture: "textures/crystal_block.png"
    hardness: 5
    sound: "stone"
    light: 7
    redstone: "source"
}

// слабый источник: сигнал 4 (доходит на 3 блока провода)
block dim_redstone_block {
    name: {ru: "Тусклый редстоун-блок", en: "Dim redstone block"}
    texture: "textures/dim_redstone_block.png"
    hardness: 3
    sound: "stone"
    redstone: {type: "source", power: 4}
}

// лампы: горят от сигнала (как лампа игры, но со своим видом)
block quartz_lamp {
    name: {ru: "Кварцевая лампа", en: "Quartz lamp"}
    texture: "textures/quartz_lamp_off.png"
    hardness: 0.3
    sound: "glass"
    redstone: {type: "lamp", on: "quartz_lamp_lit"}
}
block quartz_lamp_lit {
    name: {ru: "Кварцевая лампа", en: "Quartz lamp"}
    texture: "textures/quartz_lamp_on.png"
    hardness: 0.3
    sound: "glass"
    light: 15
    redstone: {type: "lamp_on", off: "quartz_lamp"}
}
block emerald_lamp {
    name: {ru: "Изумрудная лампа", en: "Emerald lamp"}
    texture: "textures/emerald_lamp_off.png"
    hardness: 0.3
    sound: "glass"
    redstone: {type: "lamp", on: "emerald_lamp_lit"}
}
block emerald_lamp_lit {
    name: {ru: "Изумрудная лампа", en: "Emerald lamp"}
    texture: "textures/emerald_lamp_on.png"
    hardness: 0.3
    sound: "glass"
    light: 15
    redstone: {type: "lamp_on", off: "emerald_lamp"}
}

// ---------------------------------------------------------------- крафты (recipe.*: NOVA держит их в книге рецептов игры)
var REDSTONE = 331
var QUARTZ = 406
var EMERALD = 388
var STONE = 1
var GLOWSTONE = 89
var LAMP = 123          // лампа игры

// rows: строки по 3 символа (пробел = пусто), keys: [["R", id], ...]
fn shaped(result, count, rows, keys) {
    var k = {}
    for p in keys { k[p[0]] = p[1] }
    recipe.shaped(result, rows, k, count)
}

on world.join(e) {
    shaped(redstone_crystal, 1, [" R ", "RQR", " R "], [["R", REDSTONE], ["Q", QUARTZ]])
    shaped(crystal_block, 1, ["CCC", "CCC", "CCC"], [["C", redstone_crystal]])
    shaped(dim_redstone_block, 4, ["SRS", "RSR", "SRS"], [["S", STONE], ["R", REDSTONE]])
    shaped(quartz_lamp, 1, ["QRQ", "RGR", "QRQ"], [["Q", QUARTZ], ["R", REDSTONE], ["G", GLOWSTONE]])
    shaped(emerald_lamp, 1, [" E ", "ELE", " E "], [["E", EMERALD], ["L", LAMP]])
}

// ---------------------------------------------------------------- /redstone: выдать всё
fn give(id, count) {
    if not player.give(id, count) { ui.tip("§cвыдавать может только хост мира") }
}

on chat(e) {
    if e.text != "/redstone" { return }
    e.cancel()
    give(redstone_crystal, 16)
    give(crystal_block, 8)
    give(dim_redstone_block, 8)
    give(quartz_lamp, 8)
    give(emerald_lamp, 8)
    ui.tip("§cОбновление редстоуна: §fвсё выдано")
}
