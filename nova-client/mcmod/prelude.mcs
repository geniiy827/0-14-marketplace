// Встроенные функции, написанные на самом McMod Script (реализация "script" в api/*.tsv).
// Их можно заменить через override, как и любые другие.

fn __player_look() {
    var yaw = player.yaw()
    var pitch = player.pitch()
    var c = math.cos(pitch)
    return {x: -math.sin(yaw) * c, y: -math.sin(pitch), z: math.cos(yaw) * c}
}

fn __world_day() {
    return math.floor(world.time() / 24000)
}

fn __world_fill(x1, y1, z1, x2, y2, z2, block, data = 0) {
    var n = (math.abs(x2 - x1) + 1) * (math.abs(y2 - y1) + 1) * (math.abs(z2 - z1) + 1)
    if n > 32768 {
        print("world.fill: слишком большая область ({n} блоков, максимум 32768)")
        return 0
    }
    for x in x1..x2 {
        for y in y1..y2 {
            for z in z1..z2 {
                world.setBlock(x, y, z, block, data)
            }
        }
    }
    return n
}

